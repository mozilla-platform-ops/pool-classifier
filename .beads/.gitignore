# Personal Beads .gitignore reference
#
# Curated from the generated br init template, the beads_rust checkout's
# .beads/.gitignore, and locally observed runtime artifacts. Review against
# both sources when updating this file.

# SQLite database family
*.db
*.db?*
*.db-journal
*.db-wal
*.db-shm
db.sqlite
bd.db

# Lock files
*.lock

# Temporary and recovery state
last-touched
*.tmp
.br_recovery/

# Local history backups
.br_history/

# Sync state (local-only, per-machine)
.sync.lock
sync_base.jsonl

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
sync-state.json

# Local version tracking
.local_version

# Worktree redirect file (contains a clone-local path)
redirect

# bv (beads viewer) lock file
.bv.lock
